<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GRIMECORE SOLUTION</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #18324a; background: #f5f9fc; }
    header { background: #0b6e99; color: white; padding: 18px 8%; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
    header h1 { font-size: 1.35rem; }
    nav a { color: white; text-decoration: none; margin-left: 15px; }
    .hero { padding: 70px 8%; background: linear-gradient(120deg, #dff5ff, #ffffff); display: grid; grid-template-columns: 1fr 1fr; gap: 35px; align-items: center; }
    .hero h2 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1; margin-bottom: 18px; }
    .hero p { margin-bottom: 25px; }
    .button { display: inline-block; background: #f5a623; color: #142b3b; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: bold; border: none; cursor: pointer; }
    .hero-image { min-height: 280px; border-radius: 18px; background: linear-gradient(135deg, #80c9ed, #d8f4ff); display: flex; align-items: center; justify-content: center; font-size: 5rem; }
    section { padding: 55px 8%; }
    section h2 { text-align: center; margin-bottom: 25px; }
    .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .card { background: white; padding: 25px; border-radius: 14px; box-shadow: 0 5px 18px #18324a12; }
    .price { color: #0b6e99; font-size: 1.6rem; font-weight: bold; margin: 10px 0; }
    form { max-width: 650px; margin: auto; background: white; padding: 28px; border-radius: 14px; box-shadow: 0 5px 18px #18324a12; }
    label { display: block; margin-top: 14px; font-weight: bold; }
    input, select, textarea { width: 100%; padding: 12px; margin-top: 5px; border: 1px solid #c4d4df; border-radius: 7px; font: inherit; }
    textarea { min-height: 100px; }
    form .button { margin-top: 20px; width: 100%; }
    .note { text-align: center; margin-top: 15px; color: #536b7c; font-size: .9rem; }
    footer { background: #18324a; color: white; text-align: center; padding: 25px 8%; }
    @media (max-width: 700px) {
      .hero, .cards { grid-template-columns: 1fr; }
      nav a { margin-left: 8px; font-size: .9rem; }
    }
  </style>
